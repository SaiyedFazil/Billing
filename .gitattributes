# Store and check out text files with LF on every OS. Prettier writes LF, so a
# Windows checkout converting to CRLF would make `format:check` fail on files
# nobody touched.
* text=auto eol=lf

# Binary assets — never touch their bytes.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
