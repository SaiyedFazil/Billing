{
  "name": "billing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:drop-all": "tsx --env-file=.env.local scripts/db-drop-all.ts",
    "db:dump": "tsx --env-file=.env.local scripts/dump-json.ts",
    "db:studio": "drizzle-kit studio",
    "db:ping": "tsx --env-file=.env.local scripts/db-ping.ts",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:verify": "tsx --env-file=.env.local scripts/verify-constraints.ts",
    "db:verify-immutability": "tsx --env-file=.env.local scripts/verify-immutability.ts",
    "verify:money": "tsx scripts/verify-money.ts",
    "verify:retry": "tsx scripts/verify-retry.ts",
    "verify:bill": "tsx --env-file=.env.local scripts/verify-create-bill.ts",
    "verify:stock": "tsx --env-file=.env.local scripts/verify-stock.ts",
    "verify:offline": "npm run verify:money && npm run verify:retry && npm run verify:reports && npm run verify:stock-utils && npm run verify:cash-book-utils && npm run typecheck && npm run lint && npm run format:check",
    "verify:all": "npm run verify:offline && npm run db:verify && npm run db:verify-immutability && npm run verify:bill && npm run verify:stock && npm run verify:expenses && npm run verify:categories && npm run verify:items && npm run verify:users && npm run verify:report-queries && npm run verify:imagekit",
    "verify:categories": "tsx --env-file=.env.local scripts/verify-categories.ts",
    "verify:items": "tsx --env-file=.env.local scripts/verify-items.ts",
    "verify:imagekit": "tsx --env-file=.env.local scripts/verify-imagekit.ts",
    "verify:reports": "tsx scripts/verify-reports-utils.ts",
    "verify:stock-utils": "tsx scripts/verify-stock-utils.ts",
    "verify:report-queries": "tsx --env-file=.env.local scripts/verify-report-queries.ts",
    "verify:users": "tsx --env-file=.env.local scripts/verify-users.ts",
    "db:reset-bills": "tsx --env-file=.env.local scripts/reset-bills.ts",
    "verify:cash-book-utils": "tsx scripts/verify-cash-book-utils.ts",
    "verify:expenses": "tsx --env-file=.env.local scripts/verify-expenses.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "big.js": "^7.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/big.js": "^7.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
