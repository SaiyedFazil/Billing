# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database — Neon POOLED connection string (it must contain "-pooler")
# Create a project at https://console.neon.tech and copy the pooled URL.
# The non-pooled URL will appear to hang under serverless functions.
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Auth.js — generate a secret with:  npx auth secret
# AUTH_URL must be the deployed origin in production, localhost in dev.
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ImageKit — item photos. Not used until M4; leave blank for now.
# Free tier: 5 GB storage, 20 GB bandwidth, no credit card.
# ---------------------------------------------------------------------------
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
# Photos upload through the server, so nothing ImageKit needs a NEXT_PUBLIC_
# copy. Do not add one: Netlify's secret scan fails the deploy when it finds
# such a value in the build output, where Next.js always puts it.

# ---------------------------------------------------------------------------
# Seed script only. Used once by `npm run db:seed` to create the first
# superadmin. Clear the password from this file after the first run.
# Minimum 8 characters.
# ---------------------------------------------------------------------------
SEED_SUPERADMIN_USERNAME=owner
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Shop Owner
